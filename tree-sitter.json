{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "bg3_stats",
      "camelcase": "Bg3Stats",
      "scope": "source.bg3-stats",
      "path": "tree-sitter-bg3-stats",
      "highlights": "tree-sitter-bg3-stats/queries/highlights.scm",
      "injections": "tree-sitter-bg3-stats/queries/injections.scm",
      "injection-regex": "^bg3_stats$"
    },
    {
      "name": "bg3_stats_value",
      "camelcase": "Bg3StatsValue",
      "scope": "source.bg3-stats-value",
      "path": "tree-sitter-bg3-stats-value",
      "highlights": "tree-sitter-bg3-stats-value/queries/highlights.scm",
      "injection-regex": "^bg3_stats_value$"
    },
    {
      "name": "bg3_thoth",
      "camelcase": "Bg3Thoth",
      "scope": "source.bg3-thoth",
      "path": "tree-sitter-bg3-thoth",
      "file-types": ["khn"],
      "highlights": "tree-sitter-bg3-thoth/queries/highlights.scm",
      "locals": "tree-sitter-bg3-thoth/queries/locals.scm",
      "tags": "tree-sitter-bg3-thoth/queries/tags.scm",
      "injection-regex": "^bg3_thoth$"
    },
    {
      "name": "bg3_osiris",
      "camelcase": "Bg3Osiris",
      "scope": "source.bg3-osiris",
      "path": "tree-sitter-bg3-osiris",
      "highlights": "tree-sitter-bg3-osiris/queries/highlights.scm",
      "tags": "tree-sitter-bg3-osiris/queries/tags.scm",
      "injection-regex": "^bg3_osiris$"
    }
  ],
  "metadata": {
    "version": "0.6.0",
    "license": "MIT",
    "description": "Tree-sitter grammars for Baldur's Gate 3 data, Thoth, and Osiris files",
    "links": {
      "repository": "https://github.com/datwaft/tree-sitter-bg3"
    },
    "authors": [
      {
        "name": "datwaft"
      }
    ]
  },
  "bindings": {
    "c": true,
    "go": false,
    "java": false,
    "node": false,
    "python": false,
    "rust": true,
    "swift": false,
    "zig": false
  }
}
